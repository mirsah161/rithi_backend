{
  "kind": "singleType",
  "collectionName": "footer_links",
  "info": {
    "singularName": "footer-link",
    "pluralName": "footer-links",
    "displayName": "Footer Link"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "social_links": {
      "type": "component",
      "component": "footer.social-link",
      "repeatable": true,
      "required": true
    },
    "trustBadges": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service"
    },
    "footerAddress": {
      "type": "component",
      "component": "address.address",
      "repeatable": true
    }
  }
}
